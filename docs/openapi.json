    "/api/reviews/{inn}": {
      "get": {
        "summary": "Отзывы о поставщике из 2ГИС по требованию",
        "description": "Cards of 2GIS that carry the name of the company, how far each is trusted (`basis`, `verified`), and the\nnewest reviews of the trusted ones: quote, date, link — every one with its Evidence.",
        "operationId": "api_reviews_api_reviews__inn__get",
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inn"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ключ API, если на сервере задан API_KEY",
              "title": "X-Api-Key"
            },
            "description": "ключ API, если на сервере задан API_KEY"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewsResult"
                }
              }
            }
          },
          "401": {
            "description": "нужен ключ API (X-API-Key), если на сервере задан API_KEY"
          },
          "429": {
            "description": "2ГИС запрашивают другие пользователи; повторите через Retry-After секунд"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
