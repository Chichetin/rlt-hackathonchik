{
  "openapi": "3.1.0",
  "info": {
    "title": "RLT.Hack — подбор поставщиков для АИС ГЗ",
    "description": "Подбор поставщиков, производителей и дистрибьюторов с объяснением и источниками фактов.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/testset": {
      "get": {
        "summary": "Get Testset",
        "operationId": "get_testset_api_testset_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedTestset"
                }
              }
            }
          },
          "404": {
            "description": "набор не загружен"
          }
        }
      },
      "post": {
        "summary": "Upload Testset",
        "description": "Test export files (CSV text) -> the active set; 422 with a message on a broken format, 413 over the limit.",
        "operationId": "upload_testset_api_testset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadTestsetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedTestset"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Testset",
        "operationId": "delete_testset_api_testset_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/testset/predict.csv": {
      "get": {
        "summary": "Predict Testset",
        "description": "`make predict` over the active set: per lot «История» and «Новые» with score and components.",
        "operationId": "predict_testset_api_testset_predict_csv_get",
        "parameters": [
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "кандидатов в каждом блоке",
              "default": 10,
              "title": "Top"
            },
            "description": "кандидатов в каждом блоке"
          },
          {
            "name": "offline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "«Новые» только из кеша, без сети",
              "default": true,
              "title": "Offline"
            },
            "description": "«Новые» только из кеша, без сети"
          }
        ],
        "responses": {
          "200": {
            "description": "выдача по каждой процедуре (CSV «;»)",
            "content": {
              "text/csv": {}
            }
          },
          "404": {
            "description": "набор не загружен"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "Api Search",
        "operationId": "api_search_api_search_post",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "строк в каждом блоке",
              "default": 20,
              "title": "Limit"
            },
            "description": "строк в каждом блоке"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "сдвиг в каждом блоке",
              "default": 0,
              "title": "Offset"
            },
            "description": "сдвиг в каждом блоке"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
