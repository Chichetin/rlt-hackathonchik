{
  "openapi": "3.1.0",
  "info": {
    "title": "RLT.Hack — подбор поставщиков для АИС ГЗ",
    "description": "Подбор поставщиков, производителей и дистрибьюторов с объяснением и источниками фактов.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "Api Search",
        "operationId": "api_search_api_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/counterparty/{inn}": {
      "get": {
        "summary": "Api Counterparty",
        "operationId": "api_counterparty_api_counterparty__inn__get",
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Counterparty"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/enrich/{inn}": {
      "post": {
        "summary": "Api Enqueue",
        "operationId": "api_enqueue_api_enrich__inn__post",
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/export": {
      "post": {
        "summary": "Api Export",
        "operationId": "api_export_api_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Counterparty": {
        "properties": {
          "inn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inn"
          },
          "kpp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kpp"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "manufacturer",
                  "distributor",
                  "dealer",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "is_msp": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Msp"
          },
          "in_rnp": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Rnp"
          },
          "okved": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Okved"
          },
          "contacts": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Contacts"
          },
          "stats": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Stats"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inn",
          "name"
        ],
        "title": "Counterparty"
      },
      "CounterpartyMatch": {
        "properties": {
          "counterparty": {
            "$ref": "#/components/schemas/Counterparty"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ScoreComponent"
            },
            "type": "array",
            "title": "Components"
          },
          "origin": {
            "type": "string",
            "enum": [
              "history",
              "discovered"
            ],
            "title": "Origin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "counterparty",
          "score",
          "components",
          "origin"
        ],
        "title": "CounterpartyMatch"
      },
      "EnqueueResult": {
        "properties": {
          "task_id": {
            "type": "integer",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "EnqueueResult"
      },
      "Evidence": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "fact": {
            "type": "string",
            "title": "Fact"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "url",
          "fetched_at",
          "fact"
        ],
        "title": "Evidence",
        "description": "One fact and where it came from. A fact without Evidence is not shown (CLAUDE.md).\n\n`url` is required: organizers' data uses `data:<table>#<row key>`, the web uses http(s).\nThe DATA loader MUST add `Evidence(field=\"inn\", value=<inn>, url=\"data:…\")` for every\ncounterparty from organizers' data: without it strip_unverified() shows \"ИНН не подтверждён\".\n`field`/`value` name the extracted value (inn, phone, email, address, ...); for web\nsources `value` must literally occur in the cached page text (src/enrich/evidence.py)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub"
          },
          "llm": {
            "type": "string",
            "title": "Llm"
          },
          "queue": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Queue"
          }
        },
        "type": "object",
        "required": [
          "status",
          "stub",
          "llm",
          "queue"
        ],
        "title": "Health"
      },
      "Query": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "okpd2": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Okpd2"
          },
          "ktru": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ktru"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "Санкт-Петербург"
          },
          "budget": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "customer_inn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Inn"
          },
          "channel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ЭМ",
                  "АИС ГЗ"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "filters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "object",
            "title": "Filters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query_id",
          "text"
        ],
        "title": "Query",
        "description": "Customer need: an item name, a description or a fragment of the spec.\n\nMirrors one notice (lot) of organizers' data (research/DATA_DICTIONARY.md): in the product\nthe user fills `text` (and optionally the rest); in backtest every field comes from the lot."
      },
      "ScoreComponent": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "product_fit",
              "experience",
              "reliability",
              "activity",
              "geography",
              "price"
            ],
            "title": "Name"
          },
          "value": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Value"
          },
          "weight": {
            "type": "number",
            "minimum": 0.0,
            "title": "Weight"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "title": "Explanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "weight",
          "explanation"
        ],
        "title": "ScoreComponent"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/CounterpartyMatch"
            },
            "type": "array",
            "title": "History"
          },
          "discovered": {
            "items": {
              "$ref": "#/components/schemas/CounterpartyMatch"
            },
            "type": "array",
            "title": "Discovered"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "history",
          "discovered"
        ],
        "title": "SearchResponse",
        "description": "API envelope: two blocks of the result (the incumbent trap, methodology step 5)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
