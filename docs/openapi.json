{
  "openapi": "3.1.0",
  "info": {
    "title": "RLT.Hack — подбор поставщиков для АИС ГЗ",
    "description": "Подбор поставщиков, производителей и дистрибьюторов с объяснением и источниками фактов.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/testset": {
      "get": {
        "summary": "Get Testset",
        "operationId": "get_testset_api_testset_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedTestset"
                }
              }
            }
          },
          "404": {
            "description": "набор не загружен"
          }
        }
      },
      "post": {
        "summary": "Upload Testset",
        "description": "Test export files (CSV text) -> the active set; 422 with a message on a broken format, 413 over the limit.",
        "operationId": "upload_testset_api_testset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadTestsetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedTestset"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Testset",
        "operationId": "delete_testset_api_testset_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/testset/predict.csv": {
      "get": {
        "summary": "Predict Testset",
        "description": "`make predict --offline` over the active set: per lot «История» and «Новые» with score and components.",
        "operationId": "predict_testset_api_testset_predict_csv_get",
        "parameters": [
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "кандидатов в каждом блоке",
              "default": 10,
              "title": "Top"
            },
            "description": "кандидатов в каждом блоке"
          },
          {
            "name": "offline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "только 1: «Новые» из кеша, без сети",
              "default": true,
              "title": "Offline"
            },
            "description": "только 1: «Новые» из кеша, без сети"
          }
        ],
        "responses": {
          "200": {
            "description": "выдача по каждой процедуре (CSV «;»)",
            "content": {
              "text/csv": {}
            }
          },
          "404": {
            "description": "набор не загружен"
          },
          "422": {
            "description": "offline=0: живой прогон по всем лотам — только make predict"
          }
        }
      }
    },
