# Скопировать в .env (в git не попадает). Значения — плейсхолдеры.
# LLM в продукте: none — обязательный режим без LLM. Разрешённые провайдеры — [СПРОСИТЬ Q-13].
LLM_PROVIDER=none
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=
# Обогащение по ИНН (раздел 6 workflow) — [СПРОСИТЬ Q-04] что разрешено правилами.
DADATA_API_KEY=your_dadata_key_here
DADATA_SECRET=your_dadata_secret_here
SEARCH_API_KEY=your_search_api_key_here
# Яндекс Search API (Yandex Cloud, платный, #344): src/sources/yandex_search.py. Каждый ответ — в кеш SOURCE_CACHE,
# одинаковый запрос (после нормализации) в пределах TTL не оплачивается повторно.
YANDEX_SEARCH_API_KEY=your_yandex_search_api_key_here
# Кеш ответов и журнал трат — один на все worktree: пусто → cache/yandex_search.sqlite основной копии
YANDEX_SEARCH_CACHE=
# Каталог Yandex Cloud: пусто — берётся из ключа сервисного аккаунта
YANDEX_SEARCH_FOLDER_ID=
# Сколько попыток (ушедших запросов, в т. ч. упавших по таймауту) в сутки максимум; сверх — только кеш
YANDEX_SEARCH_DAILY_MAX=100
# Срок жизни ответа в кеше, с (30 суток); пауза между живыми запросами, с
YANDEX_SEARCH_TTL_S=2592000
YANDEX_SEARCH_MIN_INTERVAL_S=1.0
# Регион Яндекса (lr) по умолчанию для CLI: 2 — Санкт-Петербург; пусто — без региона
YANDEX_SEARCH_REGION=
# 1 — только кеш, без сети и без трат (ENRICH_OFFLINE=1 включает то же)
YANDEX_SEARCH_OFFLINE=
# Кеш внешних источников (SQLite, TTL в секундах)
SOURCE_CACHE=cache/sources.sqlite
SOURCE_CACHE_TTL_S=604800
# Блок «Новые» (discovery, D-036, D-037): реестр МСП ФНС rmsp.nalog.ru
# 1 — только кеш, без сети (демо без интернета, e2e, тесты); ENRICH_OFFLINE=1 включает то же
DISCOVERY_OFFLINE=
# Кого искать в реестре: UL — юрлица (по умолчанию), UL,IP — ещё и ИП (только факты реестра, без контактов)
DISCOVERY_NP_TYPES=UL
# 0 — не добавлять в блок «Новые» веб-лиды (configs/leads, #108); по умолчанию добавляются
# DISCOVERY_LEADS=1
# Блок «Новые» и для запроса БЕЗ ОКПД2 — по классу, который определил search() (D-141, пересматривает D-041).
# По умолчанию (пусто) включено; 0 / false / off — выключить (пустой блок, без сети)
DISCOVERY_PREDICTED_CLASS=
# История госконтрактов ЕИС (#244): срок кеша выдачи и карточки, с; сколько карточек открывать на одну проверку
# (1 запрос в минуту на каждую, Crawl-delay zakupki.gov.ru). Пусто — 604800, 2592000, 3
EIS_CONTRACTS_SEARCH_MAX_AGE_S=
EIS_CONTRACTS_CARD_MAX_AGE_S=
EIS_CONTRACTS_MAX_CARDS=
# product_fit_new блока «Новые» (#77): off | shadow | on; пусто — `mode:` из configs/discover.yaml (shadow).
# on меняет порядок «Новых» и не проверен на разметке — только для эксперимента (подтверждение №3)
DISCOVERY_NEW_FIT=
# Пауза между запросами к rmsp, с; таймаут одного запроса, с (соединение + чтение);
# пауза источника после таймаута или обрыва, с
RMSP_MIN_INTERVAL_S=1.0
RMSP_TIMEOUT_S=3.0
RMSP_DOWN_COOLDOWN_S=90
# таймаут запроса rmsp из обогащения карточки (не в бюджете поиска 4 с), с
# RMSP_QUICK_TIMEOUT_S=10.0
# Очередь обогащения: пусто → cache/queue.sqlite; в docker-compose → Postgres
DATABASE_URL=
# Доступ к /api/enrich и /api/counterparty (F-10, D-100): задан — нужен заголовок X-API-Key с этим значением;
# пусто — открыто, как в локальном демо. Для встраивания в АИС ГЗ — случайная строка здесь и аутентификация на шлюзе
API_KEY=
# Потолок ждущих задач обогащения для нового ИНН (сверх — 429); одновременных живых обращений к ФНС в /api/counterparty
ENRICH_QUEUE_MAX=2000
COUNTERPARTY_LIVE_MAX=2
# Отзывы из 2ГИС по требованию (#234, D-113): пауза между запросами к 2gis.ru, таймаут, пауза после таймаута, число одновременных
# чтений (сверх — 429). GIS2_DISABLED=1 выключает чтение 2ГИС совсем (условия использования сайта на автоматическое чтение не проверены)
GIS2_MIN_INTERVAL_S=3.0
GIS2_TIMEOUT_S=20.0
GIS2_DOWN_COOLDOWN_S=90
GIS2_DISABLED=
REVIEWS_LIVE_MAX=2
# Откуда поиск и /api/lot читают данные (D-051): auto — Postgres, если DATABASE_URL postgres и `make db-load`
# выполнен, иначе data/processed (parquet); postgres — строго (без схемы — 503); parquet — без БД
DATA_STORE=auto

# Данные организаторов (D-020): каталог с тремя CSV как выдали, вне репозитория. По умолчанию data/raw/.
DATA_RAW_DIR="data/raw"

# Остальные переменные окружения — единый список в src/settings.py; закомментированная строка показывает
# значение по умолчанию. Пустое значение (`NAME=`) считается «не задано».
# 1 — синтетическая фикстура вместо данных организаторов и плашка «демонстрационные данные» (scripts/demo.sh, D-050)
# DEMO_FIXTURE=
# 1 — обогащение только из кеша, без сети (для блока «Новые» то же включает DISCOVERY_OFFLINE)
# ENRICH_OFFLINE=
# Каталог собранного UI, который отдаёт API; по умолчанию src/ui/dist
# UI_DIST=
# Соль хэшей в оценках поставщиков (src/api/ratings.py)
# RATINGS_SALT=rlt-ratings
# Тестовые выгрузки, загруженные в интерфейсе (по умолчанию cache/testsets) и каталог тестовой выгрузки
# организаторов для /api/lot (по умолчанию не задан)
# TESTSETS_DIR=cache/testsets
# TEST_DATA_DIR=
# Результат ingest (parquet) и схема Postgres, куда `make db-load` кладёт те же данные
# DATA_PROCESSED_DIR=data/processed
# DATA_SCHEMA=data
# Каталог индексов BM25 (по умолчанию indexes) и токенайзер, который переопределяет `tokenizer:` из configs/search.yaml
# INDEX_DIR=indexes
# BM25_TOKENIZER=
# Инструменты оценки (src/eval). EVAL_FINAL_CONFIRM ставит `make eval-final CONFIRM=<sha256>` — руками не задавать;
# USER — кто запускал eval-final, пишется в eval/final-log.md (обычно задан системой; пусто — «?»)
# EVAL_FINAL_CONFIRM=
# USER=
# dev_full.jsonl и каталог пула (make pool-load) из другой копии репозитория — для worktree без data/
# DEV_FULL=
# POOL_DIR=
# Эмбеддинги со стенда GPU и дообученные модели (src/eval/emb_bench.py); относительный путь — от корня репозитория
# DATA_GPU_DIR=data/gpu
# MODELS_DIR=models
# Через сколько секунд задача очереди в статусе running считается упавшей (воркер упал и не вернул её)
# QUEUE_STALE_RUNNING_S=600
# Открытые источники (src/sources): паузы, таймауты и сроки кеша, с (в т. ч. SOURCE_CACHE_TTL_S, RNP_MAX_AGE_S),
# читаются при импорте модуля источника (нужен перезапуск); PB_DISABLED и FNS_OPENDATA_* — при каждом обращении
# PB_MIN_INTERVAL_S=1.0
# 1 — pb.nalog.ru не спрашивать (капча, D-052): обогащение идёт через реестр МСП и ГИР БО
# PB_DISABLED=
# BO_MIN_INTERVAL_S=1.0
# BO_TIMEOUT_S=5.0
# РНП ЕИС: пауза (не меньше crawl-delay robots.txt; пусто — ровно он) и возраст кеша, с
# RNP_MIN_INTERVAL_S=
# RNP_MAX_AGE_S=86400
# Открытые данные ФНС (#59): каталог архивов и собранный parquet (пусто — DATA_PROCESSED_DIR/fns_opendata.parquet)
# FNS_OPENDATA_DIR=data/external/fns_opendata
# FNS_OPENDATA_PARQUET=
