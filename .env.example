# Скопировать в .env (в git не попадает). Значения — плейсхолдеры.
# LLM в продукте: none — обязательный режим без LLM. Разрешённые провайдеры — [СПРОСИТЬ Q-13].
LLM_PROVIDER=none
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=
# Обогащение по ИНН (раздел 6 workflow) — [СПРОСИТЬ Q-04] что разрешено правилами.
DADATA_API_KEY=your_dadata_key_here
DADATA_SECRET=your_dadata_secret_here
SEARCH_API_KEY=your_search_api_key_here
# Яндекс Search API (Yandex Cloud, платный, #344): src/sources/yandex_search.py. Каждый ответ — в кеш SOURCE_CACHE,
# одинаковый запрос (после нормализации) в пределах TTL не оплачивается повторно.
YANDEX_SEARCH_API_KEY=your_yandex_search_api_key_here
# Каталог Yandex Cloud: пусто — берётся из ключа сервисного аккаунта
YANDEX_SEARCH_FOLDER_ID=
# Сколько живых (платных) запросов в сутки максимум; сверх — только кеш
YANDEX_SEARCH_DAILY_MAX=100
# Срок жизни ответа в кеше, с (30 суток); пауза между живыми запросами, с
YANDEX_SEARCH_TTL_S=2592000
YANDEX_SEARCH_MIN_INTERVAL_S=1.0
# Регион Яндекса (lr) по умолчанию для CLI: 2 — Санкт-Петербург; пусто — без региона
YANDEX_SEARCH_REGION=
# 1 — только кеш, без сети и без трат (ENRICH_OFFLINE=1 включает то же)
YANDEX_SEARCH_OFFLINE=
# Кеш внешних источников (SQLite, TTL в секундах)
SOURCE_CACHE=cache/sources.sqlite
SOURCE_CACHE_TTL_S=604800
# Блок «Новые» (discovery, D-036, D-037): реестр МСП ФНС rmsp.nalog.ru
# 1 — только кеш, без сети (демо без интернета, e2e, тесты); ENRICH_OFFLINE=1 включает то же
DISCOVERY_OFFLINE=
# Кого искать в реестре: UL — юрлица (по умолчанию), UL,IP — ещё и ИП (только факты реестра, без контактов)
DISCOVERY_NP_TYPES=UL
# 1 — строить блок «Новые» и для запроса БЕЗ ОКПД2, по классу, который предсказал search().
# По умолчанию выключено (D-041): предсказание на реальных данных ошибается (#63). Включать после
# вливания #63 и повторной проверки 5 текстовых запросов.
DISCOVERY_PREDICTED_CLASS=
# Пауза между запросами к rmsp, с; таймаут одного запроса, с (соединение + чтение);
# пауза источника после таймаута или обрыва, с
RMSP_MIN_INTERVAL_S=1.0
RMSP_TIMEOUT_S=3.0
RMSP_DOWN_COOLDOWN_S=90
# Очередь обогащения: пусто → cache/queue.sqlite; в docker-compose → Postgres
DATABASE_URL=
# Доступ к /api/enrich и /api/counterparty (F-10, D-100): задан — нужен заголовок X-API-Key с этим значением;
# пусто — открыто, как в локальном демо. Для встраивания в АИС ГЗ — случайная строка здесь и аутентификация на шлюзе
API_KEY=
# Потолок ждущих задач обогащения для нового ИНН (сверх — 429); одновременных живых обращений к ФНС в /api/counterparty
ENRICH_QUEUE_MAX=2000
COUNTERPARTY_LIVE_MAX=2
# Откуда поиск и /api/lot читают данные (D-051): auto — Postgres, если DATABASE_URL postgres и `make db-load`
# выполнен, иначе data/processed (parquet); postgres — строго (без схемы — 503); parquet — без БД
DATA_STORE=auto

# Данные организаторов (D-020): каталог с тремя CSV как выдали, вне репозитория. По умолчанию data/raw/.
DATA_RAW_DIR="data/raw"
