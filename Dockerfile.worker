# Лёгкий образ воркера обогащения (T-13): без UI (node) и без torch (extra ml) — воркер только ходит в источники
# и пишет в очередь/кеш. Зависимости строго по uv.lock. api собирается основным Dockerfile.
FROM python:3.12-slim
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 PYTHONPATH=/app UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir uv==0.12.19
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --extra pg
COPY src/ src/
COPY configs/ configs/
CMD ["python", "-m", "src.worker.worker"]
