{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune)",
      "Bash(git merge origin/main)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin --delete worktree-*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D worktree-*)",
      "Bash(bash scripts/issues.sh:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * --delete main)",
      "Bash(git push * :main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main)",
      "Bash(git branch -d main)",
      "Bash(git branch -D main)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push *:main*)",
      "Bash(git push *+*)",
      "Bash(git push * -f *)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git checkout -- *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --set-upstream origin main*)",
      "Bash(git push * main)",
      "Bash(git restore .)",
      "Bash(git restore :/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-data-files.sh pre-tool",
            "timeout": 15,
            "statusMessage": "Страж данных: нет ли данных, кеша и больших файлов в коммите…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-secrets.sh",
            "timeout": 30,
            "statusMessage": "Поиск секретов в файлах для коммита…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-tests.sh",
            "timeout": 240,
            "statusMessage": "Тесты (pytest, vitest), если что-то менялось…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-upstream.sh stop",
            "timeout": 30,
            "statusMessage": "Чужие коммиты в origin/main против текущей работы…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-upstream.sh post",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-worktrees.sh",
            "timeout": 60,
            "statusMessage": "Секреты в worktree субагентов…"
          }
        ]
      }
    ]
  }
}
