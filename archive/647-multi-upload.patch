+++ b/src/ui/src/Contacts.tsx
@@ -0,0 +1,76 @@
+import { useEffect, useState } from "react";
+import type { CounterpartyMatch } from "./api";
+import type { components } from "./api-types";
+
+type Cp = CounterpartyMatch["counterparty"];
+type Evidence = components["schemas"]["Evidence"];
+type Row = { field: string; value: string; source?: Evidence };
+
+const LABEL: Record<string, string> = { phone: "Телефон", email: "Email", site: "Сайт", address: "Адрес" };
+
+function href(field: string, value: string): string | undefined {
+  if (field === "phone") return `tel:${value.replace(/[^\d+]/g, "")}`;
+  if (field === "email") return `mailto:${value}`;
+  if (field === "site") return value.startsWith("http") ? value : `https://${value}`;
+  return undefined;
+}
+
+/** Contacts of the supplier: those the search already has (cp.contacts, each with its Evidence) plus the phone and
+ *  email of the МСП registry by INN (/api/contacts), asked when the card opens. Every value links to its source. */
+export function Contacts({ cp }: { cp: Cp }) {
+  const [found, setFound] = useState<Evidence[] | null>(null);
+  useEffect(() => {
+    if (!cp.inn) {
+      setFound([]);
+      return;
+    }
+    const controller = new AbortController();
+    fetch(`/api/contacts/${cp.inn}`, { signal: controller.signal })
+      .then((r) => (r.ok ? r.json() : []))
+      .then((evs: Evidence[]) => setFound(evs))
+      .catch(() => {
+        if (!controller.signal.aborted) setFound([]);
+      });
+    return () => controller.abort();
+  }, [cp.inn]);
+
+  const rows: Row[] = Object.entries(cp.contacts ?? {}).map(([field, value]) => ({
+    field,
+    value,
+    source: (cp.evidence ?? []).find((e) => e.field === field && e.value === value),
+  }));
+  for (const ev of found ?? []) {
+    if (ev.field && ev.value && !rows.some((r) => r.field === ev.field && r.value === ev.value)) {
+      rows.push({ field: ev.field, value: ev.value, source: ev });
+    }
+  }
+
+  return (
+    <section className="requisites" aria-label="Контакты" aria-busy={found === null}>
+      <h3>Контакты</h3>
+      {rows.length > 0 && (
+        <dl className="facts">
+          {rows.map((r) => {
+            const link = href(r.field, r.value);
+            return [
+              <dt key={`k-${r.field}-${r.value}`}>{LABEL[r.field] ?? r.field}</dt>,
+              <dd key={`v-${r.field}-${r.value}`}>
+                {link ? <a href={link} target={r.field === "site" ? "_blank" : undefined} rel="noreferrer">{r.value}</a> : r.value}
+                {r.source && (
+                  <>
+                    {" · "}
+                    <a className="hint" href={r.source.url} target="_blank" rel="noreferrer">{r.source.source}</a>
+                  </>
+                )}
+              </dd>,
+            ];
+          })}
+        </dl>
+      )}
+      {found === null && <p className="hint" role="status">Ищем контакты в реестре МСП и на companium.ru…</p>}
+      {found !== null && rows.length === 0 && (
+        <p className="hint">{cp.inn ? "В открытых источниках контактов не нашли." : "ИНН не подтверждён — искать контакты не по чему."}</p>
+      )}
+    </section>
+  );
+}
