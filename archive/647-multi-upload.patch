diff --git a/src/sources/companium.py b/src/sources/companium.py
new file mode 100644
index 00000000..c574a2fa
--- /dev/null
+++ b/src/sources/companium.py
@@ -0,0 +1,93 @@
+"""companium.ru — the company card by OGRN: phones, emails and site the card lists. Owner: SOURCES.
+
+One GET of https://companium.ru/id/<ogrn> per company (robots.txt closes /search? and /id/*/contacts; the card
+itself is open), through SourceCache, one request at a time with MIN_INTERVAL_S between them. Only the contact
+block of the card is kept, as flat lines `phone: …` / `email: …` / `site: …`, so every value is literally on the
+cached page (src/enrich/evidence.py). A 403/429 or a page without the OGRN (a protection page) pauses the host.
+"""
+
+from __future__ import annotations
+
+import html
+import re
+
+import httpx
+
+from src.sources.cache import CachedPage, SourceCache
+from src.sources.pacing import HostPacer
+
+SOURCE = "companium.ru"
+BASE = "https://companium.ru"
+MIN_INTERVAL_S = 2.0
+BLOCK_COOLDOWN_S = 600.0
+DOWN_COOLDOWN_S = 60.0
+TIMEOUT_S = 10.0
+UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36"
+PACER = HostPacer(lambda: MIN_INTERVAL_S, BLOCK_COOLDOWN_S)
+
+_BLOCK_START = re.compile(r">\s*(?:Телефоны|Электронная почта|Веб-сайт)\s*</strong>")
+_BLOCK_END = re.compile(r"Соцсети и мессенджеры|Юридический адрес|Адрес</")
+_TEL = re.compile(r'href="tel:[^"]*"[^>]*>([^<]+)</a>')
+_MAIL = re.compile(r'href="mailto:([^"?]+)"')
+_SITE = re.compile(r'Веб-сайт\s*</strong>\s*<a[^>]*href="(https?://[^"]+)"')
+
+
+class Blocked(RuntimeError):
+    """The host refuses us (403/429, a protection page): stop for a while."""
+
+
+def card_url(ogrn: str) -> str:
+    if not (ogrn.isascii() and ogrn.isdigit() and len(ogrn) in (13, 15)):
+        raise ValueError(f"companium: OGRN {ogrn!r} is not 13/15 digits")
+    return f"{BASE}/id/{ogrn}"
+
+
+def flatten(page: str) -> str:
+    """The contact block of the card as flat lines; empty when the card lists no contacts."""
+    start = _BLOCK_START.search(page)
+    if start is None:
+        return ""
+    end = _BLOCK_END.search(page, start.end())
+    block = page[start.start(): end.start() if end else start.end() + 6000]
+    lines = [f"phone: {html.unescape(t).strip()}" for t in _TEL.findall(block)]
+    lines += [f"email: {html.unescape(m).strip()}" for m in _MAIL.findall(block)]
+    lines += [f"site: {html.unescape(s).strip()}" for s in _SITE.findall(block)]
+    return "\n".join(dict.fromkeys(lines))
+
+
+def contacts(body: str) -> list[tuple[str, str]]:
+    """(field, value) pairs of a cached card, in the card's order."""
+    out = []
+    for line in body.splitlines():
+        field, _, value = line.partition(": ")
+        if field in ("phone", "email", "site") and value:
+            out.append((field, value))
+    return out
+
+
+def fetch_card(ogrn: str, cache: SourceCache | None = None, offline: bool = False) -> CachedPage | None:
+    """Cached card (stale is fine offline); None offline when absent."""
+    cache = cache or SourceCache()
+    url = card_url(ogrn)
+    if offline:
+        return cache.get(url, allow_stale=True)
+
+    def live(_: str) -> tuple[int, str]:
+        if PACER.blocked():
+            raise Blocked("companium.ru: пауза после отказа источника ещё не истекла")
+        with PACER.slot(timeout=TIMEOUT_S) as limit:
+            try:
+                r = httpx.get(url, headers={"User-Agent": UA, "Accept-Language": "ru"}, timeout=limit,
+                              follow_redirects=True)
+            except httpx.TransportError:
+                PACER.block(DOWN_COOLDOWN_S)
+                raise
+        if r.status_code == 404:
+            return 404, ""
+        if r.status_code in (403, 429) or (r.status_code == 200 and ogrn not in r.text):
+            PACER.block()
+            raise Blocked(f"companium.ru: HTTP {r.status_code}, страница без ОГРН — источник ограничил доступ")
+        r.raise_for_status()
+        return 200, flatten(r.text)
+
+    return cache.fetch(url, live)
