+@app.get("/api/contacts/{inn}", response_model=list[Evidence], dependencies=[Depends(guard.require_api_key)])
+def api_contacts(inn: str) -> list[Evidence]:
+    """Phone, email and site of the company: the МСП registry quick search by INN, then the companium.ru card by
+    OGRN (legal entities only: of an ИП only registries, 152-ФЗ). Cache first, else one live request per source;
+    only values that pass the Evidence check against their cached page."""
+    if not inn_is_valid(inn):
+        raise HTTPException(422, "ИНН не проходит контрольные цифры")
+    cache = SourceCache()
+    offline = get_settings().enrich_offline
+    out: list[Evidence] = []
+
+    def add(source: str, page: CachedPage, pairs: list[tuple[str, str]]) -> None:
+        at = datetime.fromtimestamp(page.fetched_at, tz=UTC)
+        for field, value in pairs:
+            if any(e.field == field and e.value == value for e in out):
+                continue
+            ev = Evidence(source=source, url=page.url, fetched_at=at, fact=f"{CONTACT_LABEL[field]}: {value}",
+                          field=field, value=value)
+            if not check_evidence(ev, cache.page_text):
+                out.append(ev)
+
+    ogrn = None
+    try:
+        page = rmsp.fetch_quick(inn, cache, offline=offline)
+    except (rmsp.Blocked, TimeoutError, httpx.HTTPError, ValueError) as e:
+        log.warning("contacts %s: реестр МСП не ответил (%s)", inn, e)
+        page = None
+    row = next((r for r in rmsp.parse(page.body).rows if r.get("inn") == inn), None) if page else None
+    if page is not None and row is not None:
+        ogrn = row.get("ogrn")
+        add(rmsp.SOURCE, page, [(f, row[f].strip()) for f in ("phone", "email") if (row.get(f) or "").strip()])
+    if not ogrn:
+        try:
+            card = enrich_mod.enrich(inn, cache, offline=True, open_data=False)
+            ogrn = next((e.value for e in card.evidence if e.field == "ogrn" and e.value), None)
+        except (KeyError, ValueError) as e:
+            log.warning("contacts %s: ОГРН не найден в кеше (%s)", inn, e)
+    if ogrn and len(inn) == 10:
+        try:
+            card_page = companium.fetch_card(ogrn, cache, offline=offline)
+        except (companium.Blocked, httpx.HTTPError, ValueError) as e:
+            log.warning("contacts %s: companium.ru не ответил (%s)", inn, e)
+            card_page = None
+        if card_page is not None and card_page.status == 200:
+            add(companium.SOURCE, card_page, companium.contacts(card_page.body))
+    return out
+
