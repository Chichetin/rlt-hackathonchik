+    monkeypatch.setattr(R, "load_cases", lambda part, cfg=None: cases)
+    monkeypatch.setattr(R, "RESULTS", tmp_path)
+    assert R.main(["--exp", "B-pop"]) == 0
+    rec = json.loads((tmp_path / "B-pop.json").read_text(encoding="utf-8"))
+    assert rec["config_path"] == "configs/baselines/B-pop.yaml" and rec["config"]["baseline"] == "pop"
+    assert rec["slices"]["new_for_customer"]["n"] == 1 and rec["slices"]["known_for_customer"]["n"] == 1
+    assert rec["stub"] is False and rec["n_queries"] == 2
