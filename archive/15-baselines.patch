+"""Baselines B-pop / B-inc / B-bm25 and eval slices (T-08, #15, D-033): hand-computed on the ingest fixture.
+
+Fixture (tests/fixtures/ingest/README.md), cutoff 2025-07-01. Paper (OKPD2 17.12.14.110, group 17.12):
+lot 1 (2024-03-01, customer 7801000051): 7801000012 won, 7801000020, 780100000090 lost;
+lot 3 (2024-11-05, customer 7701000040): 7801000012 won, 4701000038 lost, 7801000013 invalid INN;
+lot 6 (2025-08-01, customer 7801000051): 780100000090 won, 7801000012 lost — after cutoff;
+lot 7 (2025-10-15, customer 7701000040): 470100000088 won, 7801000012 lost — after cutoff.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+from pathlib import Path
+
+import pytest
+import yaml
+
+from src.contracts import Query
+from src.eval import baselines as B
+from src.eval import run as R
+from src.eval import slices as S
+from src.eval.split import EvalCase
+from src.match import search as search_mod
+
+CUTOFF = date(2025, 7, 1)
+ROOT = Path(__file__).resolve().parents[2]
+PAPER = "17.12.14.110"
+A, B2, C, D, E, F = ("7801000012", "7801000020", "780100000090", "4701000038", "470100000088", "7802010006")
+CUST1, CUST2 = "7801000051", "7701000040"
+
+
+def q(codes: list[str] | None = None, customer: str | None = None, as_of: date | None = CUTOFF,
+      text: str = "бумага", channel: str | None = "ЭМ") -> Query:
+    return Query(query_id="q", text=text, okpd2=codes if codes is not None else [PAPER], customer_inn=customer,
+                 channel=channel, as_of=as_of)  # type: ignore[arg-type]
+
+
+def ranker(baseline: str, **cfg):
+    return B.make_ranker({"baseline": baseline, "k": cfg.pop("k", 20), **cfg})
+
+
+def case(qid: str, relevant: dict[str, int], customer: str | None, channel: str | None = "ЭМ",
+         codes: list[str] | None = None) -> EvalCase:
+    query = q(codes, customer, channel=channel).model_copy(update={"query_id": qid})
+    return EvalCase(query=query, relevant_inns=sorted(relevant), date=date(2025, 7, 10), grades=relevant)
+
+
+# --- B-pop -------------------------------------------------------------------------------------
+
+def test_pop_ranks_by_group_participations_then_wins_then_inn(search_data):
+    assert ranker("pop", k=4)(q()) == [A, D, C, B2]  # A: 2 lots/2 wins; the rest 1 lot/0 wins in the group, by INN
+
+
+def test_pop_pads_with_global_popularity(search_data):
+    # group has 4 suppliers; the fifth comes from the whole history (E took part in lot 4, before cutoff)
+    assert ranker("pop", k=6)(q()) == [A, D, C, B2, E]
+    assert ranker("pop")(q([])) == [A, B2, D, E, C]  # no OKPD2 -> global: A 3 lots/3 wins, B2 3/2, D 2, E, C
+
+
+def test_pop_backs_off_from_group_to_class(search_data):
+    assert ranker("pop", k=3)(q(["17.99.99.999"])) == [A, D, C]  # no group 17.99 -> class 17
+    assert ranker("pop", k=3, levels=[4])(q(["17.99.99.999"])) == [A, B2, D]  # no backoff: whole history
+
+
+def test_pop_excludes_lots_on_and_after_as_of(search_data):
+    assert E not in ranker("pop", k=3)(q())  # E's only paper lot is 7 (after cutoff)
+    assert ranker("pop", k=3)(q(as_of=date(2026, 1, 1))) == [A, C, E]  # all data: lots 1, 3, 6, 7
+    assert ranker("pop", k=3)(q(as_of=date(2024, 3, 1))) == [A]  # lot 1 is ON as_of -> not history
+    assert ranker("pop", k=3)(q(as_of=date(2024, 3, 2))) == [A, C, B2]  # a day later it is
+
+
+def test_pop_never_returns_invalid_inn(search_data):
+    assert "7801000013" not in ranker("pop")(q())
+
+
+def test_rank_by_is_validated(search_data):
+    with pytest.raises(ValueError, match="rank_by"):
+        ranker("pop", rank_by=["price"])(q())
+
+
+def test_rank_by_decides_between_many_lots_and_wins(tmp_path, monkeypatch):
+    """S3: 3 lots, no win; S5, S9: 1 lot, 1 win; S1: 1 lot, no win — all in group 10.10 before as_of."""
+    import duckdb
+
+    rows = [(1, "S3", False), (1, "S9", True), (2, "S3", False), (2, "S1", False), (3, "S3", False), (3, "S5", True)]
+    con = duckdb.connect()
+    con.execute("CREATE TABLE p(lot_id BIGINT, supplier_inn VARCHAR, is_winner BOOLEAN, inn_valid BOOLEAN,"
+                " publish_date DATE, customer_inn VARCHAR)")
+    con.executemany("INSERT INTO p VALUES (?, ?, ?, true, DATE '2024-05-01', 'c1')", rows)
+    con.execute("CREATE TABLE i AS SELECT * FROM (VALUES (1, '10', '10.10'), (2, '10', '10.10'), (3, '10', '10.10'))"
+                " t(lot_id, okpd2_l2, okpd2_l4)")
+    con.execute(f"COPY p TO '{tmp_path / 'participants.parquet'}' (FORMAT parquet)")
+    con.execute(f"COPY i TO '{tmp_path / 'items.parquet'}' (FORMAT parquet)")
+    monkeypatch.setattr(B, "processed_dir", lambda: tmp_path)
+    query = q(["10.10.10.100"], as_of=date(2025, 1, 1))
+    assert ranker("pop")(query) == ["S3", "S5", "S9", "S1"]  # lots first, then wins, then INN
+    assert ranker("pop", rank_by=["wins", "lots"])(query) == ["S5", "S9", "S3", "S1"]
+    assert ranker("pop")(q([], as_of=date(2025, 1, 1))) == ["S3", "S5", "S9", "S1"]  # global padding: lots, wins, INN
+    assert ranker("inc")(q(["10.10.10.100"], "c1", as_of=date(2025, 1, 1))) == ["S5", "S9", "S3", "S1"]  # wins first
+
+
+# --- B-inc -------------------------------------------------------------------------------------
+
+def test_inc_puts_customer_incumbents_first_then_pop(search_data):
+    # customer 7801000051 before cutoff: only lot 1 -> A (won), C, B2; padded by B-pop: D, E
+    assert ranker("inc", k=5)(q(customer=CUST1)) == [A, C, B2, D, E]
+    assert ranker("pop", k=5)(q()) == [A, D, C, B2, E]  # B-pop puts D second: customer history decides
+    assert ranker("inc", k=4)(q(customer=CUST2)) == [A, D, C, B2]  # lot 3: A won, D lost
+
+
+def test_inc_does_not_see_the_customers_later_lots(search_data):
+    assert ranker("inc", k=2)(q(customer=CUST2)) == [A, D]  # E won lot 7 at CUST2, after cutoff
+    assert ranker("inc", k=3)(q(customer=CUST2, as_of=date(2026, 1, 1))) == [A, E, D]
+
+
+def test_inc_without_customer_is_pop(search_data):
+    assert ranker("inc", k=5)(q(customer=None)) == ranker("pop", k=5)(q())
+
+
+def test_inc_unknown_customer_is_pop(search_data):
+    assert ranker("inc", k=5)(q(customer="7800000000")) == ranker("pop", k=5)(q())
+
+
+# --- B-bm25 ------------------------------------------------------------------------------------
+
+def test_bm25_ranks_participants_of_the_best_matching_lot(search_data):
+    ranked = ranker("bm25")(q(text="Бумага офисная"))
+    assert ranked[0] == A and D in ranked and E not in ranked and "7801000013" not in ranked
+
+
+def test_bm25_sees_only_history_before_as_of(search_data):
+    assert ranker("bm25")(q(text="Ручки шариковые")) == []  # lot 7 is after cutoff
+    assert set(ranker("bm25")(q(text="Ручки шариковые", as_of=date(2026, 1, 1)))) == {A, E}
+
+
+def test_bm25_unknown_words_give_nothing(search_data):
+    assert ranker("bm25")(q(text="zzzz qqqq")) == []
+
+
+def test_bm25_ignores_okpd2_and_customer(search_data):
+    base = ranker("bm25")(q(text="Бумага офисная", codes=[], customer=None))
+    assert ranker("bm25")(q(text="Бумага офисная", codes=["26.20.40.110"], customer=CUST1)) == base
+
+
+# --- common ------------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("kind", B.KINDS)
+def test_baseline_refuses_query_without_as_of(search_data, kind):
+    with pytest.raises(ValueError, match="утечка"):
+        ranker(kind)(q(as_of=None))
+
+
+def test_unknown_baseline_is_refused():
+    with pytest.raises(ValueError, match="baseline"):
+        B.make_ranker({"baseline": "random"})
+
+
+def test_baseline_configs_are_valid_and_do_not_touch_the_product_config():
+    files = sorted((ROOT / "configs" / "baselines").glob("*.yaml"))
+    assert {f.stem for f in files} == {"B-pop", "B-inc", "B-bm25"}
+    for f in files:
+        assert yaml.safe_load(f.read_text(encoding="utf-8"))["baseline"] in B.KINDS
+    assert "baseline" not in yaml.safe_load((ROOT / "configs" / "search.yaml").read_text(encoding="utf-8"))
+
+
+def test_resolve_config_by_experiment_id(tmp_path):
+    assert R.resolve_config("B-pop") == ROOT / "configs" / "baselines" / "B-pop.yaml"
+    assert R.resolve_config("E-001") == R.SEARCH_CONFIG
+    assert R.resolve_config("B-pop", Path("configs/search.yaml")) == ROOT / "configs" / "search.yaml"
+    assert R.resolve_config("x", tmp_path / "c.yaml") == tmp_path / "c.yaml"
+
+
+# --- evaluate: baseline instead of search(), slices ---------------------------------------------
+
+def test_evaluate_runs_the_baseline_not_the_product_search(search_data, monkeypatch):
+    monkeypatch.setattr(search_mod, "search", lambda *a, **k: pytest.fail("search() called for a baseline"))
+    c = case("c1", {D: 1}, CUST1)
+    body = R.evaluate([c], {"baseline": "pop", "k": 4})
+    assert body["per_query"][0]["mrr"] == 0.5 and body["per_query"][0]["recall@10"] == 1.0  # D is 2nd
+
+
+def test_evaluate_slices_by_channel_and_customer_history(search_data):
+    cases = [
+        case("known-em", {A: 2, D: 1}, CUST1),           # A won at CUST1 before: known
+        case("new-em", {E: 2}, CUST2),                   # E at CUST2 only after cutoff: new
+        case("new-aisgz", {F: 2}, CUST1, "АИС ГЗ"),      # F never seen: new (and cold)
+        case("nowinner-em", {A: 1}, CUST1),              # no winner: in no customer slice
+        case("mixed-em", {F: 2, A: 1}, CUST1),           # winner F is cold; loser A is found
+        case("nochannel", {A: 2}, CUST1, None),          # channel unknown: only in «all»
+    ]
+    flags = S.case_flags(cases, CUTOFF)
+    body = R.evaluate(cases, {"baseline": "inc", "k": 5}, CUTOFF, flags)
+    sl = body["slices"]
+    assert {k: v["n"] for k, v in sl.items()} == {"all": 6, "ЭМ": 4, "АИС ГЗ": 1, "new_for_customer": 3,
+                                                  "known_for_customer": 2}
+    by_id = {p["query_id"]: p for p in body["per_query"]}
+    new_mrr = [by_id[i]["mrr"] for i in ("new-em", "new-aisgz", "mixed-em")]
+    assert sl["new_for_customer"]["metrics"]["mrr"]["value"] == pytest.approx(sum(new_mrr) / 3)
+    assert by_id["mixed-em"]["recall@10"] == 0.5 and by_id["mixed-em"]["winner_recall@10"] == 0.0
+    assert by_id["known-em"]["mrr"] == 1.0 and by_id["new-aisgz"]["mrr"] == 0.0  # F can't be found: no history
+    assert by_id["nowinner-em"]["winner_recall@10"] is None and by_id["known-em"]["winner_recall@10"] == 1.0
+    assert sl["АИС ГЗ"]["metrics"]["recall@10"]["ci95"] == [0.0, 0.0]  # one query: the point twice
+    assert body["metrics"] == {k: sl["all"]["metrics"][k] for k in body["metrics"]}
+
