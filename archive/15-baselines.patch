+
+
+def test_new_for_customer_flag(search_data):
+    f = flags([
+        case("known", {A: 2}, CUST1),
+        case("new", {E: 2}, CUST2),
+        case("one-known-winner", {E: 2, A: 2}, CUST2),
+        case("nowinner", {A: 1}, CUST1),
+        case("nocustomer", {A: 2}, None),
+        case("cold", {F: 2}, CUST1),
+        case("one-cold-winner", {F: 2, A: 2}, CUST1),
+    ])
+    assert {k: v.new_for_customer for k, v in f.items()} == {
+        "known": False, "new": True, "one-known-winner": False, "nowinner": None, "nocustomer": None, "cold": True,
+        "one-cold-winner": False}
+    assert {k: v.winner_cold for k, v in f.items()} == {
+        "known": False, "new": False, "one-known-winner": False, "nowinner": None, "nocustomer": False, "cold": True,
+        "one-cold-winner": False}
+    assert {k: v.relevant_cold for k, v in f.items()}["cold"] is True
+
+
+def test_flag_uses_only_participations_before_the_cutoff(search_data):
+    """E won at CUST2 in lot 7 (2025-10-15): known only to a cutoff after that day (strictly before)."""
+    c = [case("c", {E: 2}, CUST2)]
+    assert flags(c, CUTOFF)["c"].new_for_customer is True
+    assert flags(c, date(2025, 10, 15))["c"].new_for_customer is True  # the lot day itself is not history
+    assert flags(c, date(2025, 10, 16))["c"].new_for_customer is False
+    # E took part elsewhere (lot 4, 2025-02-14): not a cold start at the cutoff, and not before that day
+    assert flags(c, CUTOFF)["c"].winner_cold is False and flags(c, date(2025, 2, 14))["c"].winner_cold is True
+
+
+def test_history_stats(search_data):
+    cases = [case("known", {A: 2, D: 1}, CUST1), case("new", {E: 2}, CUST2), case("cold", {F: 2}, CUST1),
+             case("nowinner", {A: 1}, CUST1)]
+    st = S.history_stats(flags(cases))
+    assert st == {"n": 4, "n_with_winner": 3, "winner_without_history": 0.25, "all_relevant_without_history": 0.25,
+                  "winner_new_for_customer": 0.5, "n_new_for_customer": 2}
