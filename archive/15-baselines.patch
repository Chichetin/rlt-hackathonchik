diff --git a/src/eval/baselines.py b/src/eval/baselines.py
new file mode 100644
index 00000000..dfc7f1df
--- /dev/null
+++ b/src/eval/baselines.py
@@ -0,0 +1,180 @@
+"""Baselines for `make eval` (T-08, research/EVAL.md A, D-033): what we must beat.
+
+A baseline is a configuration (configs/baselines/<id>.yaml, key `baseline`) that ranks INNs from
+organizers' history strictly before `Query.as_of` — nothing else, no scoring components:
+
+  pop   B-pop    popularity: suppliers by participations (then wins) in the OKPD2 group of the lot
+                 (4 digits, backoff to the 2-digit class, then to the whole history);
+  inc   B-inc    incumbents: suppliers that took part at THIS customer in that group (wins first,
+                 then participations), backoff to the class, then padded by B-pop;
+  bm25  B-bm25   pure lexical BM25 over lot positions (src/match index, no OKPD2 depth, experience,
+                 activity or geography): supplier score = best BM25 of the lots it took part in.
+
+`src/match` is only read through its public index (`get_index`, `tokenize`); the product search()
+and configs/search.yaml are untouched. Ties are broken by INN, so the ranking is deterministic.
+A query without `as_of` is refused: a baseline that sees the whole data would leak the test lot.
+"""
+
+from __future__ import annotations
+
+import threading
+from collections.abc import Callable
+from datetime import date
+from pathlib import Path
+
+import duckdb
+
+from src.contracts import Query
+from src.match.index import get_index, processed_dir
+from src.match.text import tokenize
+
+KINDS = ("pop", "inc", "bm25")
+# OKPD2 level (digits) -> (ps column, prefix length): okpd2_l4 = code[:5] "XX.XX", okpd2_l2 = code[:2]
+LEVELS = {4: ("g4", 5), 2: ("g2", 2)}
+ORDER = {"lots": "count(DISTINCT lot_id)", "wins": "count(DISTINCT lot_id) FILTER (win)"}
+GLOBAL_POOL = 500  # globally most popular suppliers kept as the last padding
+
+
+def _lit(path: Path) -> str:
+    return "'" + path.as_posix().replace("'", "''") + "'"
+
+
+def _order_sql(rank_by: list[str]) -> str:
+    bad = [r for r in rank_by if r not in ORDER]
+    if bad or not rank_by:
+        raise ValueError(f"rank_by {rank_by!r}: допустимо {sorted(ORDER)}")
+    return ", ".join(f"{ORDER[r]} DESC" for r in rank_by) + ", inn"
+
+
+def _groups(codes: list[str], level: int) -> list[str]:
+    n = LEVELS[level][1]
+    return sorted({c.strip()[:n] for c in codes if len(c.strip()) >= n})
+
+
+class History:
+    """Participations before `as_of` with the OKPD2 groups of their lots (one table, valid INNs only)."""
+
+    def __init__(self, processed: Path, as_of: date) -> None:
+        self.as_of = as_of
+        self.con = duckdb.connect()
+        self._lock = threading.Lock()
+        p, i = _lit(processed / "participants.parquet"), _lit(processed / "items.parquet")
+        cond = f"publish_date < DATE '{as_of.isoformat()}' AND inn_valid"
+        self.con.execute(
+            f"""
+            CREATE TABLE ps AS
+            SELECT p.lot_id, p.supplier_inn AS inn, p.is_winner AS win, p.customer_inn AS cust,
+                   i.okpd2_l2 AS g2, i.okpd2_l4 AS g4
+            FROM (SELECT * FROM read_parquet({p}) WHERE {cond}) p
+            JOIN read_parquet({i}) i USING (lot_id)
+            ORDER BY p.customer_inn
+            """
+        )
+        self.global_top = [r[0] for r in self.con.execute(
+            f"""
+            SELECT supplier_inn AS inn FROM read_parquet({p}) WHERE {cond}
+            GROUP BY inn ORDER BY count(DISTINCT lot_id) DESC,
+                     count(DISTINCT lot_id) FILTER (is_winner) DESC, inn
+            LIMIT {GLOBAL_POOL}
+            """
+        ).fetchall()]
+
+    def top(self, codes: list[str], levels: list[int], rank_by: list[str], k: int, *, customer: str | None = None,
+            exclude: list[str] | None = None) -> list[str]:
+        """Up to k INNs by group popularity (or at `customer`), level by level until k, minus `exclude`."""
+        out: list[str] = list(exclude or [])
+        base = len(out)
+        order = _order_sql(rank_by)
+        for level in levels:
+            groups = _groups(codes, level)
+            if not groups:
+                continue
+            col = LEVELS[level][0]
+            where = f"{col} IN (SELECT unnest($g))" + (" AND cust = $c" if customer else "")
+            params: dict = {"g": groups, **({"c": customer} if customer else {})}
+            with self._lock:
+                rows = self.con.execute(
+                    f"SELECT inn FROM ps WHERE {where} GROUP BY inn ORDER BY {order} LIMIT {k + len(out)}", params
+                ).fetchall()
+            out.extend(r[0] for r in rows if r[0] not in out)
+            if len(out) - base >= k:
+                break
+        return out[base:][:k]
+
+
+def pop_rank(hist: History, query: Query, cfg: dict) -> list[str]:
+    k = cfg.get("k", 20)
+    ranked = hist.top(query.okpd2, cfg.get("levels", [4, 2]), cfg.get("rank_by", ["lots", "wins"]), k)
+    return [*ranked, *(x for x in hist.global_top if x not in ranked)][:k]
+
+
+def inc_rank(hist: History, query: Query, cfg: dict) -> list[str]:
+    k = cfg.get("k", 20)
+    ranked: list[str] = []
+    if query.customer_inn:
+        ranked = hist.top(query.okpd2, cfg.get("levels", [4, 2]), cfg.get("rank_by", ["wins", "lots"]), k,
+                          customer=query.customer_inn)
+    fill = pop_rank(hist, query, {**cfg.get("fill", {}), "k": k + len(ranked)})
+    return [*ranked, *(x for x in fill if x not in ranked)][:k]
+
+
+class Bm25Context:
+    """BM25 index (src/match, as_of = cutoff) + doc -> lot -> participant tables for one as_of."""
+
+    def __init__(self, processed: Path, as_of: date) -> None:
+        self.as_of = as_of
+        self.processed = processed
+        self.idx = get_index(processed, as_of)
+        self.con = duckdb.connect()
+        self._lock = threading.Lock()
+        p = _lit(processed / "participants.parquet")
+        docs = _lit(self.idx.path / "docs.parquet")
+        self.con.execute(f"CREATE TABLE docs AS SELECT doc_id, lot_id FROM read_parquet({docs}) ORDER BY doc_id")
+        self.con.execute(
+            f"CREATE TABLE pl AS SELECT DISTINCT lot_id, supplier_inn AS inn FROM read_parquet({p}) "
+            f"WHERE publish_date < DATE '{as_of.isoformat()}' AND inn_valid ORDER BY lot_id"
+        )
+
+    def rank(self, query: Query, k: int, top_docs: int) -> list[str]:
+        hits = self.idx.retrieve(tokenize(query.text), top_docs)
+        if not hits:
+            return []
+        with self._lock:
+            self.con.execute("CREATE OR REPLACE TEMP TABLE h AS SELECT unnest($d) AS doc_id, unnest($s) AS score",
+                             {"d": [d for d, _ in hits], "s": [s for _, s in hits]})
+            rows = self.con.execute(
+                f"""
+                SELECT pl.inn FROM (SELECT lot_id, max(score) AS score
+                                    FROM docs JOIN h USING (doc_id) GROUP BY lot_id) l
+                JOIN pl USING (lot_id)
+                GROUP BY pl.inn ORDER BY max(l.score) DESC, count(*) DESC, pl.inn LIMIT {k}
+                """
+            ).fetchall()
+        return [r[0] for r in rows]
+
+
+def make_ranker(cfg: dict) -> Callable[[Query], list[str]]:
+    """Query -> ranked INNs for the baseline named by cfg["baseline"]."""
+    kind = cfg.get("baseline")
+    if kind not in KINDS:
+        raise ValueError(f"baseline {kind!r}: допустимо {KINDS}")
+    processed = processed_dir()
+    contexts: dict[date, History | Bm25Context] = {}
+    lock = threading.Lock()
+
+    def context(as_of: date | None, query_id: str) -> History | Bm25Context:
+        if as_of is None:
+            raise ValueError(f"{query_id}: baseline без as_of видел бы всю историю — утечка тестовой закупки")
+        with lock:
+            if as_of not in contexts:
+                contexts[as_of] = Bm25Context(processed, as_of) if kind == "bm25" else History(processed, as_of)
+            return contexts[as_of]
+
+    def rank(query: Query) -> list[str]:
+        ctx = context(query.as_of, query.query_id)
+        k = cfg.get("k", 20)
+        if isinstance(ctx, Bm25Context):
+            return ctx.rank(query, k, cfg.get("top_docs", 500))
+        return (pop_rank if kind == "pop" else inc_rank)(ctx, query, cfg)
+
+    return rank
