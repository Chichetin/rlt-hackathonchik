index 00000000..7239841b
--- /dev/null
+++ b/src/eval/slices.py
@@ -0,0 +1,84 @@
+"""Case flags for eval slices, computed ONLY from participations strictly before the cutoff (D-018, D-033).
+
+  new_for_customer  every winner (grade 2) had no offer or win at this `customer_inn` before cutoff —
+                    the case where "ask whoever supplied us before" (B-inc) can not work.
+                    None: the case has no winner (ЭМ lots without one) or no customer.
+  winner_cold       every winner had no participation anywhere before cutoff (cold start).
+                    None: no winner.
+  relevant_cold     every relevant INN had no participation before cutoff: recall ceiling on history.
+
+`history_stats` turns the flags into the shares written to eval/cases/build_stats.json
+(research/EVAL.md): the numbers there are reproduced by `uv run python -m src.eval.build_cases`.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+
+import duckdb
+
+from src.eval.split import EvalCase
+from src.match.index import processed_dir
+
+
+@dataclass(frozen=True)
+class CaseFlags:
+    new_for_customer: bool | None
+    winner_cold: bool | None
+    relevant_cold: bool
+
+
+def winners(case: EvalCase) -> list[str]:
+    return sorted(inn for inn, g in case.grades.items() if g == 2)
+
+
+def case_flags(cases: list[EvalCase], cutoff: date, processed: Path | None = None) -> dict[str, CaseFlags]:
+    """query_id -> flags from `participants.parquet` rows with publish_date < cutoff (strictly)."""
+    processed = processed or processed_dir()
+    path = (processed / "participants.parquet").as_posix().replace("'", "''")
+    inns = sorted({i for c in cases for i in c.relevant_inns})
+    customers = sorted({c.query.customer_inn for c in cases if c.query.customer_inn})
+    con = duckdb.connect()
+    try:
+        con.execute("CREATE TEMP TABLE q_inn AS SELECT unnest($a) AS inn", {"a": inns})
+        con.execute("CREATE TEMP TABLE q_cust AS SELECT unnest($a) AS cust", {"a": customers})
+        base = f"FROM read_parquet('{path}') WHERE publish_date < $c"
+        seen = {r[0] for r in con.execute(
+            f"SELECT DISTINCT supplier_inn {base} AND supplier_inn IN (SELECT inn FROM q_inn)", {"c": cutoff}
+        ).fetchall()}
+        pairs = set(con.execute(
+            f"SELECT DISTINCT customer_inn, supplier_inn {base} AND customer_inn IN (SELECT cust FROM q_cust)"
+            " AND supplier_inn IN (SELECT inn FROM q_inn)", {"c": cutoff}
+        ).fetchall())
+    finally:
+        con.close()
+    out: dict[str, CaseFlags] = {}
+    for c in cases:
+        won = winners(c)
+        cust = c.query.customer_inn
+        out[c.query.query_id] = CaseFlags(
+            new_for_customer=(all((cust, w) not in pairs for w in won) if won and cust else None),
+            winner_cold=(all(w not in seen for w in won) if won else None),
+            relevant_cold=all(i not in seen for i in c.relevant_inns),
+        )
+    return out
+
+
+def history_stats(flags: dict[str, CaseFlags]) -> dict:
+    """Shares of all n cases; a case without a winner (or customer) is never counted as cold / new."""
+    n = len(flags)
+    have_winner = [f for f in flags.values() if f.winner_cold is not None]
+
+    def share(hits: int, total: int) -> float:
+        return round(hits / total, 4) if total else 0.0
+
+    return {
+        "n": n,
+        "n_with_winner": len(have_winner),
+        "winner_without_history": share(sum(bool(f.winner_cold) for f in flags.values()), n),
+        "all_relevant_without_history": share(sum(f.relevant_cold for f in flags.values()), n),
+        "winner_new_for_customer": share(sum(bool(f.new_for_customer) for f in flags.values()), n),
+        "n_new_for_customer": sum(bool(f.new_for_customer) for f in flags.values()),
+    }
